# Copy this file to .env and fill in the values. Never commit .env.
# API key: elevenlabs.io -> Profile -> API Keys.
# Paste the secret that starts with sk_ (shown only when the key is created or rotated).
# Do not paste the key ID from the keys list.
ELEVENLABS_API_KEY=sk_your_secret_key_here
# Agent IDs: elevenlabs.io -> Agents -> open the agent -> copy Agent ID (starts with agent_)
MUMMY_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAPA_ELEVENLABS_AGENT_ID=agent_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
PORT=8787
