# Copy to .env.local for Next.js, or .env for scripts. Never commit real values.

# ElevenLabs (server only — never NEXT_PUBLIC_)
ELEVENLABS_API_KEY=sk_your_secret_key_here
MUMMY_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAPA_ELEVENLABS_AGENT_ID=agent_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Production: hosted PostgreSQL (Neon, Vercel Postgres, or similar)
# Leave empty for local SQLite in ./data/smaran.db (not used on Vercel)
DATABASE_URL=

# Signs session tokens in production
AUTH_SECRET=generate_a_long_random_string

# Public site URL after deploy, e.g. https://your-app.vercel.app
APP_URL=http://localhost:8787

# Vercel Cron: set the same value in Vercel project settings
CRON_SECRET=generate_another_long_random_string
